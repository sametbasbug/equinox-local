---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import ProductPreview from './ProductPreview.astro';
import release from '../data/release.json';
import { github, pathFor, ui, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const tr = lang === 'tr';
const t = (en: string, turkish: string) => tr ? turkish : en;
const features = [
  { icon: 'terminal', label: t('FILES, CODE & COMMANDS', 'DOSYALAR, KOD VE KOMUTLAR'), title: t('From a conversation\nto a working project.', 'Sohbetten\nçalışan projeye.'), body: t('Ask your agent in ChatGPT to edit files, run builds and tests, work with Git, and use the tools already on your computer. Long-running commands can keep going while the agent checks back on the same process.', 'ChatGPT’deki ajanınızdan dosyaları düzenlemesini, derleme ve testleri çalıştırmasını, Git ve bilgisayarınızdaki araçlarla iş yapmasını isteyin. Uzun süren komutlar, ajan aynı sürece geri dönüp sonucu alana kadar çalışmaya devam edebilir.'), note: t('Terminal runs as your logged-in operating-system user. You can turn it off.', 'Terminal, oturum açtığınız işletim sistemi kullanıcısının yetkileriyle çalışır. İstediğinizde kapatabilirsiniz.') },
  { icon: 'browser', label: t('EQUINOX BROWSER', 'EQUINOX BROWSER'), title: t('A browser for your agent.\nYour browser when needed.', 'Ajanınıza ayrı tarayıcı.\nGerektiğinde sizinki.'), body: t('Browse, fill forms, inspect pages, and check a finished website. Agent Browser uses its own Chrome profile by default. Choose Your Browser explicitly when a task needs your personal sessions.', 'Gezinin, formları doldurun, sayfaları inceleyin ve tamamlanan siteyi kontrol edin. Agent Browser varsayılan olarak kendi Chrome profilini kullanır. Kişisel oturumlarınız gereken işlerde Your Browser’ı açıkça seçin.'), note: t('Separate profiles. Separate consent. No silent fallback.', 'Ayrı profiller. Ayrı onay. Sessiz geçiş yok.') },
  { icon: 'desktop', label: t('BEYOND THE BROWSER', 'TARAYICININ ÖTESİNDE'), title: t('Work where\nthe work happens.', 'İş neredeyse,\norada çalışın.'), body: t('On macOS, enable Desktop control for supported local interactions. On macOS or Windows, add optional Telegram delivery for agent status messages.', 'macOS’ta desteklenen yerel etkileşimler için Desktop kontrolünü etkinleştirin. macOS veya Windows’ta ajan durum mesajları için isteğe bağlı Telegram teslimatını bağlayın.'), note: t('Desktop automation is currently macOS-only. Telegram is send-only.', 'Desktop otomasyonu şu anda yalnızca macOS’tadır. Telegram yalnızca mesaj gönderir.') },
];
const faqs = [
  [t('Do I keep using ChatGPT on the web?', 'ChatGPT’yi web’de kullanmaya devam mı ediyorum?'), t('Yes. You keep working with your agent in ChatGPT on the web. Equinox Local connects that agent to tools running on your computer through the configured MCP tunnel. It does not move the AI model onto your computer or replace your ChatGPT conversation with a separate chat app. Task-relevant information is shared with the connected provider.', 'Evet. Ajanınızla ChatGPT web’de çalışmaya devam edersiniz. Equinox Local, yapılandırdığınız MCP tüneli üzerinden o ajanı bilgisayarınızda çalışan araçlara bağlar. Yapay zekâ modelini bilgisayarınıza taşımaz veya ChatGPT sohbetinizin yerine ayrı bir sohbet uygulaması koymaz. Görev için gerekli bilgiler bağlı sağlayıcıyla paylaşılır.')],
  [t('What do I need to get started?', 'Başlamak için ne gerekiyor?'), t('A supported 64-bit macOS or Windows computer (ARM64 or x64) and a normal user account. The installer bundles the runtime; no separate Node installation is required. ChatGPT connection also requires an OpenAI tunnel, a restricted runtime key, and a plan/workspace that supports the custom MCP connection.', 'Desteklenen 64-bit macOS veya Windows bilgisayar (ARM64 ya da x64) ve normal bir kullanıcı hesabı. Çalışma ortamı kurulumla gelir; ayrıca Node kurmanız gerekmez. ChatGPT bağlantısı için OpenAI tüneli, kısıtlı bir runtime anahtarı ve özel MCP bağlantısını destekleyen plan/çalışma alanı da gerekir.')],
  [t('Can I limit access to selected folders?', 'Erişimi seçili klasörlerle sınırlayabilir miyim?'), t('Yes, for root-aware structured capabilities: switch Agent Access from Full to Selected and choose your roots. Terminal is a separate broad shell capability and is not confined to Selected roots after it starts. Disable Terminal if strict selected-root containment is your requirement.', 'Kök farkındalığı olan yapılandırılmış yeteneklerde evet: Agent Access’i Full modundan Selected moduna alın ve kökleri seçin. Terminal ayrı, geniş yetkili bir shell erişimidir ve başladıktan sonra Selected köklerle sınırlı kalmaz. Kesin klasör sınırlaması gerekiyorsa Terminal’i kapatın.')],
  [t('Do I have to give it my personal Chrome?', 'Kişisel Chrome’umu kullanıma açmak zorunda mıyım?'), t('No. Browser automation is optional. The default Agent Browser has a dedicated profile separate from your personal Chrome. Your Browser is used only when explicitly selected. Install Equinox Browser and accept its disclosure in each profile you want to automate.', 'Hayır. Tarayıcı otomasyonu isteğe bağlıdır. Varsayılan Agent Browser kişisel Chrome’unuzdan ayrı bir profil kullanır. Your Browser yalnızca açıkça seçildiğinde kullanılır. Otomasyon istediğiniz her profile Equinox Browser’ı kurup veri açıklamasını onaylayın.')],
  [t('Is Equinox Local open source?', 'Equinox Local açık kaynak mı?'), t('Yes. The shipped source is available on GitHub under AGPL-3.0-only, including the runtime, browser extension, tests, and security documentation. Connected AI or other service providers have their own access requirements and terms.', 'Evet. Yayınlanan kaynak kodu; çalışma ortamı, tarayıcı eklentisi, testler ve güvenlik belgeleriyle birlikte AGPL-3.0-only lisansı altında GitHub’da bulunur. Bağladığınız yapay zekâ ve diğer hizmet sağlayıcılarının erişim koşulları ve şartları ayrıdır.')],
];
---
<Layout lang={lang} title={t('Equinox Local — Your ChatGPT agent. From web to your computer.', 'Equinox Local — ChatGPT ajanınız. Web’den bilgisayarınıza.')} description={t('Connect your agent in ChatGPT on the web to local files, terminal, Chrome, and supported automation on macOS or Windows.', 'ChatGPT web’deki ajanınızı macOS veya Windows’taki yerel dosyalara, terminale, Chrome’a ve desteklenen otomasyona bağlayın.')}>
  <section class="shell hero">
    <div class="hero-heading"><a class="release-link" href={`${github}/releases/tag/v${release.version}`}><span class="tiny-dot"></span>{t(`Equinox Local ${release.version} is live`, `Equinox Local ${release.version} yayında`)}<Icon name="external" size={14} /></a><h1>{t('Your ChatGPT agent.', 'ChatGPT ajanınız.')}<br /><span>{t('From web to your computer.', 'Web’den bilgisayarınıza.')}</span></h1></div>
    <div class="hero-description"><p>{t('Keep working with your agent at chatgpt.com. Equinox Local connects it to local files, terminal, Chrome, and supported automation on macOS or Windows. Your conversation stays in ChatGPT.', 'ChatGPT’yi web’de kullanmaya devam edin. Equinox Local, oradaki ajanınızı macOS veya Windows’taki yerel dosyalara, terminale, Chrome’a ve desteklenen otomasyona bağlar. Sohbet ChatGPT’de kalır.')}</p><div class="hero-actions"><a class="button" href={pathFor(lang, 'install')}>{t('Get started', 'Başlayın')}<Icon /></a><a class="text-link" href={github}>{t('View source', 'Kaynak kodu')}<Icon name="external" size={17} /></a></div><span class="hero-platform">{ui[lang].mac}</span></div>
  </section>
  <div class="shell"><ProductPreview lang={lang} /></div>
  <div class="shell proof-strip"><span>{t('Native on macOS and Windows.', 'macOS ve Windows’ta yerel.')}</span><span><Icon name="check" size={16} />{t('No admin password', 'Yönetici parolası gerekmez')}</span><span><Icon name="check" size={16} />{t('Bundled runtime', 'Çalışma ortamı dahil')}</span><span><Icon name="check" size={16} />{t('Open source · AGPL-3.0', 'Açık kaynak · AGPL-3.0')}</span></div>
  <section class="shell section" id="capabilities">
    <div class="section-intro"><span class="eyebrow">01 / {t('REAL CAPABILITIES', 'GERÇEK YETENEKLER')}</span><h2>{t('Less back and forth.\nMore getting things done.', 'Daha az kopyala-yapıştır.\nDaha çok tamamlanan iş.')}</h2><p>{t('The agent you work with in ChatGPT on the web can now use the tools and projects on your computer.', 'ChatGPT web’de birlikte çalıştığınız ajan, artık bilgisayarınızdaki araçları ve projeleri kullanabilir.')}</p></div>
    <div class="capability-list">{features.map((feature, i) => <article class="capability-row"><div class="capability-title"><span class="feature-mark"><Icon name={feature.icon} size={23} /></span><span class="eyebrow">{feature.label}</span><h3>{feature.title}</h3></div><div class="capability-copy"><p>{feature.body}</p><div class="feature-note"><span class="tiny-dot"></span>{feature.note}</div>{i === 1 && <a class="text-link" href={pathFor(lang, 'browser')}>{t('Meet Equinox Browser', 'Equinox Browser’ı keşfedin')}<Icon size={17} /></a>}</div></article>)}</div>
  </section>
  <section class="control-section"><div class="shell control-layout"><div><span class="eyebrow">02 / {t('HUMAN CONTROLS', 'KONTROL SİZDE')}</span><h2>{t('Powerful tools.\nVisible boundaries.', 'Güçlü araçlar.\nGörünür sınırlar.')}</h2><p>{t('Control Center is your place to review connections, change Agent Access, manage capabilities, and check runtime health. It runs locally on your computer, not on this website.', 'Control Center; bağlantıları gözden geçirdiğiniz, Agent Access’i değiştirdiğiniz, yetenekleri yönettiğiniz ve çalışma durumunu izlediğiniz yer. Bu sitede değil, bilgisayarınızda yerel olarak çalışır.')}</p><a class="button button-outline" href={pathFor(lang, 'security')}>{t('Understand the security model', 'Güvenlik modelini inceleyin')}<Icon /></a></div><div class="boundary-list"><article><span>01</span><div><h3>{t('Choose the access.', 'Erişimi seçin.')}</h3><p>{t('Fresh installs start in Full mode. Choose Selected roots for structured access, and manage Terminal, Desktop, and Browser separately.', 'Yeni kurulumlar Full modunda başlar. Yapılandırılmış erişim için Selected kökleri seçin; Terminal, Desktop ve Browser’ı ayrı yönetin.')}</p></div></article><article><span>02</span><div><h3>{t('Know what leaves your computer.', 'Bilgisayarınızdan ne çıktığını bilin.')}</h3><p>{t('Connected AI and services may receive what a task needs. Local-first is not a promise of offline AI or zero data transfer.', 'Bağlı yapay zekâ ve hizmetler, görevin gerektirdiği bilgileri alabilir. Yerel öncelikli olmak, çevrimdışı yapay zekâ veya sıfır veri aktarımı vaadi değildir.')}</p></div></article><article><span>03</span><div><h3>{t('Keep a way back.', 'Geri dönüş yolu kalsın.')}</h3><p>{t('Signed Local updates are verified before activation. Failed activation triggers rollback. Chrome Web Store updates the extension separately.', 'İmzalı Local güncellemeleri etkinleştirilmeden doğrulanır. Etkinleştirme başarısızsa önceki sürüme dönülür. Eklentiyi Chrome Web Store ayrıca günceller.')}</p></div></article></div></div></section>
  <section class="shell section setup-section"><div class="section-intro"><span class="eyebrow">03 / {t('GET CONNECTED', 'BAĞLANTIYI KURUN')}</span><h2>{t('Start in ChatGPT.\nConnect your computer.', 'ChatGPT’de başlayın.\nBilgisayarınızı bağlayın.')}</h2></div><div class="setup-grid">{[
    [t('Install Local.', 'Local’i kurun.'), t('Use the macOS or Windows bootstrap. It detects ARM64 or x64, installs the bundled runtime, and opens the native Local app.', 'macOS veya Windows kurulumunu kullanın. ARM64 ya da x64 mimarisini algılar, çalışma ortamını kurar ve yerel Local uygulamasını açar.')],
    [t('Connect ChatGPT.', 'ChatGPT’yi bağlayın.'), t('Add your OpenAI Tunnel ID and restricted runtime key in Control Center. Connect the same tunnel in ChatGPT.', 'OpenAI Tunnel ID ve kısıtlı runtime anahtarınızı Control Center’a girin. ChatGPT’de aynı tüneli bağlayın.')],
    [t('Make it your own.', 'Kendinize göre ayarlayın.'), t('Review Agent Access. Add Equinox Browser for Chrome, or enable the desktop and integrations you need.', 'Agent Access’i gözden geçirin. Chrome için Equinox Browser’ı ekleyin; gereken masaüstü erişimini ve entegrasyonları etkinleştirin.')],
  ].map(([title, body], i) => <article><span class="setup-number">0{i + 1}</span><h3>{title}</h3><p>{body}</p></article>)}</div><div class="setup-bottom"><a class="text-link" href={pathFor(lang, 'install')}>{t('Follow the installation guide', 'Kurulum rehberine geçin')}<Icon size={18} /></a><p>{t('ChatGPT custom MCP availability depends on your OpenAI plan and workspace.', 'ChatGPT özel MCP erişimi, OpenAI planınıza ve çalışma alanınıza bağlıdır.')}</p></div></section>
  <section class="shell faq-section"><div><span class="eyebrow">{t('A FEW GOOD QUESTIONS', 'AKLINIZDAKİ SORULAR')}</span><h2>{t('Before you\nmake it Local.', 'Başlamadan\nönce.')}</h2><a class="text-link" href={pathFor(lang, 'contact')}>{t('Something else on your mind?', 'Başka bir sorunuz mu var?')}<Icon size={16} /></a></div><div class="faq-list">{faqs.map(([q, a]) => <details><summary>{q}<Icon name="plus" size={20} /></summary><p>{a}</p></details>)}</div></section>
  <section class="shell closing"><span class="eyebrow">EQUINOX LOCAL</span><h2>{t('Stay in ChatGPT.\nPut your computer to work.', 'Sohbet ChatGPT’de.\nİşler bilgisayarınızda.')}</h2><div><a class="button" href={pathFor(lang, 'install')}>{t('Get started', 'Başlayın')}<Icon /></a><span>{t('Your agent on the web. Your tools on your computer.', 'Ajanınız web’de. Araçlarınız bilgisayarınızda.')}</span></div></section>
</Layout>
