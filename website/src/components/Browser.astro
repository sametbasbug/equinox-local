---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import { store, pathFor, type Lang } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const t = (en: string, tr: string) => lang === 'tr' ? tr : en;
---
<Layout lang={lang} page="browser" title={t('Equinox Browser — Two spaces. One companion.', 'Equinox Browser — İki ayrı alan. Tek eklenti.')} description={t('Let your agent in ChatGPT on the web use Chrome on your Mac through Equinox Local. A dedicated Agent Browser, or personal Chrome when explicitly chosen.', 'ChatGPT web’deki ajanınız, Equinox Local üzerinden Mac’inizde Chrome’u kullansın. Ayrı Agent Browser veya açıkça seçildiğinde kişisel Chrome.')}>
  <div class="shell"><section class="browser-intro"><span class="eyebrow">{t('THE CHROME COMPANION', 'CHROME YARDIMCISI')} / EQUINOX BROWSER</span><h1>{t('Two spaces.\nOne thoughtful connection.', 'İki ayrı alan.\nTek bir bağlantı.')}</h1><p>{t('Let your agent in ChatGPT on the web use a dedicated Chrome profile on your Mac. Keep your personal Chrome separate. Equinox Browser connects both to Equinox Local, with independent consent and control for each profile.', 'ChatGPT web’deki ajanınız, Mac’inizde ayrı bir Chrome profili kullansın. Kişisel Chrome’unuz ayrı kalsın. Equinox Browser, her profil için ayrı onay ve kontrolle ikisini de Equinox Local’e bağlar.')}</p><a class="button" href={store}>{t('Add from Chrome Web Store', 'Chrome Web Store’dan ekleyin')}<Icon name="external" /></a></section>
  <div class="browser-contexts"><article class="browser-context"><div class="context-icon"><Icon name="browser" size={30} /></div><span class="eyebrow">{t('THE DEFAULT', 'VARSAYILAN')}</span><h2>Agent Browser</h2><p>{t('A dedicated Equinox Local Chrome profile for browsing, research, forms, and website checks. Its own tabs, sessions, settings, and bookmarks. Local can launch it when work needs a browser.', 'Gezinme, araştırma, formlar ve site kontrolleri için ayrı Equinox Local Chrome profili. Kendi sekmeleri, oturumları, ayarları ve yer imleriyle. İş bir tarayıcı gerektirdiğinde Local bu profili başlatabilir.')}</p><div class="feature-note"><Icon name="check" size={15} />{t('Your personal sessions stay in their own profile.', 'Kişisel oturumlarınız kendi profilinde kalır.')}</div></article><article class="browser-context"><div class="context-icon"><Icon name="browser" size={30} /></div><span class="eyebrow">{t('ONLY WHEN YOU CHOOSE', 'YALNIZCA SİZ SEÇERSENİZ')}</span><h2>Your Browser</h2><p>{t('Your personal Chrome, for tasks that need an account or session you already use. The agent must explicitly choose this context. It is never a fallback when Agent Browser is unavailable.', 'Zaten kullandığınız bir hesap veya oturum gerektiren işler için kişisel Chrome’unuz. Ajan bu bağlamı açıkça seçmelidir. Agent Browser kullanılamadığında otomatik olarak devreye girmez.')}</p><div class="feature-note"><Icon name="shield" size={15} />{t('Personal bookmark automation is not exposed.', 'Kişisel yer imleri otomasyona açılmaz.')}</div></article></div>
  <section class="faq-section"><div><span class="eyebrow">{t('A VISIBLE ON/OFF SWITCH', 'GÖRÜNÜR AÇMA/KAPAMA KONTROLÜ')}</span><h2>{t('Set up each space.\nEnable it on your terms.', 'Her alanı ayrı kurun.\nHazır olduğunuzda açın.')}</h2><a class="text-link" href={pathFor(lang, 'install') + '#browser'}>{t('See the setup steps', 'Kurulum adımlarını görün')}<Icon /></a></div><div class="prose"><section><h2>{t('One extension, installed per profile', 'Tek eklenti, her profile ayrı kurulum')}</h2><p>{t('Install Equinox Local first, then add Equinox Browser from Chrome Web Store in each profile you want to use. A new extension install starts with automation off. Read and accept the browser-data disclosure, then explicitly enable browser control.', 'Önce Equinox Local’i kurun. Ardından kullanmak istediğiniz her profile Chrome Web Store’dan Equinox Browser’ı ekleyin. Yeni eklenti kurulumu otomasyon kapalı olarak başlar. Tarayıcı verisi açıklamasını okuyup kabul edin, sonra tarayıcı kontrolünü açıkça etkinleştirin.')}</p></section><section><h2>{t('What the agent can work with', 'Ajan nelerle çalışabilir?')}</h2><p>{t('Supported actions include navigation, page inspection, screenshots, clicks, typing, forms, and bounded console/network metadata. Agent Browser also supports bookmark organization. Requested page content may be passed to your connected AI service.', 'Desteklenen işlemler arasında gezinme, sayfa inceleme, ekran görüntüsü, tıklama, yazma, formlar ve sınırlı konsol/ağ meta verileri bulunur. Agent Browser yer imi düzenlemeyi de destekler. İstenen sayfa içeriği, bağlı yapay zekâ hizmetinize aktarılabilir.')}</p></section><section><h2>{t('Off means no browser automation', 'Kapalıysa tarayıcı otomasyonu yok')}</h2><p>{t('Turning control off rejects browser-automation commands. A limited local settings channel may stay connected so you can still manage the extension. Updates come from Chrome Web Store, not the Local updater.', 'Kontrolü kapattığınızda tarayıcı otomasyon komutları reddedilir. Eklentiyi yönetebilmeniz için sınırlı yerel ayar bağlantısı açık kalabilir. Güncellemeler Local güncelleyicisinden değil, Chrome Web Store’dan gelir.')}</p><p><a href={pathFor(lang, 'privacy')}>{t('Read the browser privacy policy', 'Tarayıcı gizlilik politikasını okuyun')}</a></p></section></div></section></div>
</Layout>
