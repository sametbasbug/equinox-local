<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EquinoxLocal</AssemblyName>
    <RootNamespace>EquinoxLocal.WindowsShell</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Windows ICO is the platform container derived from the canonical app/EquinoxLocal.png artwork. -->
    <ApplicationIcon>Assets\EquinoxLocal.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="../../../app/EquinoxLocal.png" Link="Assets\EquinoxLocal.png" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>
</Project>
