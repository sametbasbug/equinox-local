<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64;ARM64</Platforms>
    <PlatformTarget Condition="'$(Platform)' == 'ARM64' Or '$(RuntimeIdentifier)' == 'win-arm64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(Platform)' != 'ARM64' And '$(RuntimeIdentifier)' != 'win-arm64'">x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../native/windows/EquinoxLocal.WindowsShell/ManagedUninstallHandoff.cs" Link="ManagedUninstallHandoff.cs" />
    <Compile Include="../../../native/windows/EquinoxLocal.WindowsShell/StartupRegistration.cs" Link="StartupRegistration.cs" />
    <Compile Include="../../../native/windows/EquinoxLocal.WindowsShell/WindowsManagedReleaseLocator.cs" Link="WindowsManagedReleaseLocator.cs" />
  </ItemGroup>
</Project>
