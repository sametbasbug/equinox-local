{
  "manifest_version": 3,
  "name": "Equinox Browser",
  "version": "0.4.0",
  "description": "Connect Equinox Local to Chrome so an agent can inspect and interact with browser tabs under your control.",
  "key": "",
  "permissions": ["debugger", "tabs", "downloads", "nativeMessaging", "alarms", "storage"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Equinox Browser",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
